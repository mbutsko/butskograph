---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Graph from '../components/Graph.tsx';
import { buildGraph } from '../lib/graph';

const entries = await getCollection('entries');
const data = buildGraph(entries);
---

<Base
  full
  title="Mike Butsko"
  description="Beliefs, memories, opinions and values, arranged by what matters most rather than by what is newest."
>
  <!-- No headline, and no page furniture. The graph is the hero; everything that
       reads as text lives in its margin column, so the drawing gets the height. -->
  <Graph data={data} client:load />
</Base>
