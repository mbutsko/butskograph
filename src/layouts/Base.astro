---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  /** One-screen pages (the graph) trade the long bottom margin for fitting. */
  full?: boolean;
}

const { title, description, full = false } = Astro.props;

/**
 * Cloudflare Web Analytics. Baked in at build time, so it is only present when the
 * token is set in the deploy environment — local builds and previews stay silent.
 * No cookies and no cross-site tracking, which is the reason it is this one.
 */
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class:list={['shell', { full }]}>
      <slot />
    </div>
    <style>
      .shell {
        /* Fits the prose measure plus the margin column and the gap between. */
        max-width: 64rem;
        margin: 0 auto;
        padding: 3.5rem 1.5rem 6rem;
      }
      /* The graph screen: wider than the prose measure, because the drawing gets
         the width the reading matter does not need, and short on padding, because
         a long tail of it is the difference between fitting one screen and not. */
      .shell.full {
        max-width: 94rem;
        padding-top: 1.5rem;
        padding-bottom: 1.25rem;
      }
      @media (max-width: 40rem) {
        .shell {
          padding: 2rem 1rem 4rem;
        }
        .shell.full {
          padding-bottom: 1.5rem;
        }
      }
    </style>
    {
      beacon && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beacon })}
        />
      )
    }
  </body>
</html>
